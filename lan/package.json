{
  "name": "lan-music",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/server",
    "apps/web",
    "packages/shared"
  ],
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0"
  },
  "packageManager": "npm@11.13.0",
  "scripts": {
    "dev:server": "npm run dev --workspace @lan/server",
    "dev:web": "npm run dev --workspace @lan/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run --config vitest.config.ts",
    "build": "npm run build --workspace @lan/shared && npm run build --workspace @lan/server && npm run build --workspace @lan/web",
    "start": "npm run start --workspace @lan/server",
    "admin": "npm run admin --workspace @lan/server --"
  },
  "overrides": {
    "vite": "7.3.1"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/ws": "8.18.1",
    "tsup": "8.5.0",
    "tsx": "4.20.5",
    "typescript": "5.9.3",
    "vitest": "4.0.18",
    "vue-tsc": "3.2.4"
  }
}
