# Example only: NOT deployed, loaded or validated on Linux.
# Review and install as /etc/lan-music/lan.env only with separate operator approval.
# Used by both systemd EnvironmentFile and Node --env-file for interactive bootstrap.
# Keep this file readable only by the operator and service account. No passwords here.
NODE_ENV=production
HOST=127.0.0.1
PORT=41840
# Replace with the single actual HTTPS LAN origin, including a non-default port if used.
# No trailing slash. The separately configured TLS proxy must preserve this Host/Origin.
PUBLIC_ORIGIN=https://music.example.test
MUSIC_ROOT=/srv/lan-music/music
DATA_DIR=/var/lib/lan-music
MPV_PATH=/usr/bin/mpv
# EXAMPLE DEVICE ONLY. Replace from reviewed mpv --audio-device=help output.
# This unit targets direct ALSA; it does not inherit a desktop PulseAudio/PipeWire session.
MPV_AUDIO_DEVICE=alsa/plughw:CARD=USB,DEV=0
DEV_SIMULATION=false
