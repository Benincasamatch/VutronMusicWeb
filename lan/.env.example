# Copy to lan/.env only after reviewing paths. There are no default accounts.
# Relative MUSIC_ROOT and DATA_DIR paths resolve against lan/, not the shell cwd.
NODE_ENV=development
HOST=127.0.0.1
PORT=41840
PUBLIC_ORIGIN=http://localhost:5174
MUSIC_ROOT=./music
DATA_DIR=./data

# Real playback: Linux only, via a private mpv child and Unix IPC socket.
MPV_PATH=/usr/bin/mpv
# Optional exact device name accepted by mpv (for example alsa/plughw:CARD=USB,DEV=0).
MPV_AUDIO_DEVICE=auto

# Explicit development-only simulation. No physical audio in simulation.
# Required for development without Linux/mpv; never enabled automatically.
DEV_SIMULATION=false

# Production requires NODE_ENV=production, DEV_SIMULATION=false and an exact
# https:// PUBLIC_ORIGIN behind an independently configured HTTPS reverse proxy.
# Keep HOST loopback. Do not run the service or administrative CLI as OS root.
# No passwords, session secrets or default credentials belong in this file.
