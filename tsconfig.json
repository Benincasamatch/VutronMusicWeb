{
  "compilerOptions": {
    "baseUrl": "./",
    "rootDir": "./src",
    "outDir": "./dist",
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "node",
    "ignoreDeprecations": "6.0",
    "jsx": "preserve",
    "noImplicitAny": false,
    "allowSyntheticDefaultImports": true,
    "declaration": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "sourceMap": true,
    "strict": true,
    "skipLibCheck": true,
    "paths": {
      "@/*": ["./src/*"]
    },
    "lib": ["esnext", "dom"],
    "types": ["node"],
    "typeRoots": ["node_modules/@types"],
    "allowJs": true
  },
  "include": ["src/renderer", "src/types"],
  // 浏览器版 shim（src/renderer/web）属于 web/ 子项目：由 web/tsconfig.json 检查、
  // web/vite.config.ts 构建，含 .ts 扩展名导入与 web/shared 契约（在桌面 rootDir 之外），
  // 故从桌面版类型检查中排除，避免破坏桌面版 vue-tsc --noEmit。
  "exclude": ["node_modules", "dist", "src/renderer/web"],
  "references": [
    {
      "path": "./tsconfig.node.json"
    }
  ]
}
