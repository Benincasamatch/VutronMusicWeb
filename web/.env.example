# VutronMusic Web 版环境变量（复制为 web/.env 或直接导出到进程环境）
# 配置项解析见 web/server/config.ts

# ── 监听 ────────────────────────────────────────────────
# 监听地址：0.0.0.0 允许局域网访问；127.0.0.1 仅本机
VW_HOST=0.0.0.0
# 服务端口
VW_PORT=41831
# 对外基地址（可选，留空按请求 Host 推断）
# VW_PUBLIC_ORIGIN=http://192.168.1.10:41831

# ── 数据 ────────────────────────────────────────────────
# 数据目录（SQLite、用户插件、缓存）
# VW_DATA_DIR=/var/lib/vutronmusic-web
# SQLite 文件路径（默认 <数据目录>/vutron-web.sqlite3）
# VW_DB_FILE=/var/lib/vutronmusic-web/vutron-web.sqlite3

# ── 初始管理员（仅首次启动、users 表为空时生效）──────────
# 用户名
VW_ADMIN_USER=admin
# 口令：留空则自动生成 16 位随机口令并写入 <数据目录>/INITIAL_ADMIN.txt
# VW_ADMIN_PASSWORD=

# ── 服务器本地音乐 ──────────────────────────────────────
# 音乐根目录，多个用逗号分隔（也可登录后在管理接口中设置）
# VW_MUSIC_DIRS=/srv/music,/mnt/flac

# ── 服务器音频输出 ──────────────────────────────────────
# 驱动：mpv（推荐，支持精确 seek/暂停）| ffplay | none（仅维护播放状态，不出声）
VW_OUTPUT_DRIVER=mpv
# VW_MPV_PATH=mpv
# VW_FFPLAY_PATH=ffplay
# 服务器输出音量 0-100
VW_OUTPUT_VOLUME=100
# mpv 输出设备（如 alsa/default、pulse/alsa_output.pci-...），留空用默认
# VW_AUDIO_DEVICE=

# ── 其它 ────────────────────────────────────────────────
# 会话有效期（天）
VW_SESSION_TTL_DAYS=30
# 日志级别：fatal|error|warn|info|debug|trace
VW_LOG_LEVEL=info
# 插件目录覆盖（默认使用仓库 src/public/plugin）
# VW_PLUGIN_DIR=/opt/vutron/plugins
